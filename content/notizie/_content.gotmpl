{{- /* Content adapter: una pagina per ogni post di social/calendario.json.
       Le pagine con data futura non vengono pubblicate (buildFuture è spento):
       compaiono quando il sito si ricompila dopo l'ora del post. */ -}}
{{- $cal := os.ReadFile "social/calendario.json" | transform.Unmarshal }}
{{- range $cal.post }}
  {{- $foto := .grafica.foto | default "" }}
  {{- $testo := replaceRE `(cooprimavera\.com(/[a-z0-9/\-]*)?)` "[$1](https://www.$1)" .fb }}
  {{- $testo = replace $testo "\n" "\n\n" }}
  {{- /* I consigli hanno un articolo più lungo, con fonti e collegamenti: sul sito vale quello */ -}}
  {{- with .articolo }}{{ $testo = . }}{{ end }}
  {{- $alt := "" }}
  {{- $tit := .grafica.titolo }}
  {{- with .grafica.righe }}{{ $alt = printf "%s: %s." $tit (delimit . "; ") }}{{ end }}
  {{- $.AddPage (dict
      "path" (strings.TrimSuffix ".jpg" .file)
      "title" .titolo
      "description" (.descrizione | default (truncate 155 (plainify (index (split .fb "\n\n") 0))))
      "dates" (dict "date" (time.AsTime (printf "%sT%s:00" .data .ora)))
      "content" (dict "mediaType" "text/markdown" "value" $testo)
      "params" (dict
        "grafica" (printf "/social/%s" .file)
        "video" (strings.TrimPrefix "https://www.cooprimavera.com" (.video | default ""))
        "tema" .grafica.tema
        "pagina_sito" .pagina_sito
        "immagine" (cond (strings.HasPrefix $foto "assets/") (strings.TrimPrefix "assets/" $foto) "")
        "titolo_seo" (.titolo_seo | default "")
        "alt" $alt)
  ) }}
{{- end }}
