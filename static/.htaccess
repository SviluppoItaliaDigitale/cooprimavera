# Cooprimavera — regole Apache (hosting Aruba)

AddDefaultCharset UTF-8

# Pagina di errore personalizzata
ErrorDocument 404 /404.html

# Redirect 301 dai vecchi URL (sito pre-2026) alle nuove pagine:
# preservano i risultati già indicizzati da Google
Redirect 301 /servizi.html https://www.cooprimavera.com/servizi/
Redirect 301 /service-details.html https://www.cooprimavera.com/servizi/
Redirect 301 /portfolio-details.html https://www.cooprimavera.com/servizi/
Redirect 301 /chi-siamo.html https://www.cooprimavera.com/chi-siamo/
Redirect 301 /assunzioni.html https://www.cooprimavera.com/lavora-con-noi/

# Tipi MIME corretti (Aruba serve i .js come text/javascript: le regole
# di compressione e cache qui sotto devono coprire entrambe le varianti)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType text/javascript .js
  AddType application/manifest+json .webmanifest
</IfModule>

# Cache del browser per le risorse statiche
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Le risorse con impronta (hash) nel nome cambiano URL quando cambiano:
  # possono restare in cache per sempre
  <FilesMatch "\.[0-9a-f]{64}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "_hu_[0-9a-f]+\.(webp|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Librerie JS auto-ospitate con versione fissa
  <FilesMatch "\.min\.js$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Le pagine HTML possono essere ricontrollate a ogni visita
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Intestazioni di sicurezza
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compressione testo (entrambi i tipi MIME per il JavaScript)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Niente ETag: la cache si basa su Cache-Control/Last-Modified
FileETag None
