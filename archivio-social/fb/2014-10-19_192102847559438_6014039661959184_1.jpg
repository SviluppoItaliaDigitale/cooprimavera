scriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CMoCEM2rARgBIhMI0vS82J6elwMVIBpoCB1FfzC9ygEEHclusg==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CMoCEM2rARgBIhMI0vS82J6elwMVIBpoCB1FfzC9ygEEHclusg==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CMoCEM2rARgBIhMI0vS82J6elwMVIBpoCB1FfzC9ygEEHclusg==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CMoCEM2rARgBIhMI0vS82J6elwMVIBpoCB1FfzC9ygEEHclusg==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Soundtrack: Claudio Brizi plays François Couperin - From/da 00:06 \"Le Réveil-Matin\" (\"The Alarm Clock\"); From/da 03:45 excerpt of \"Désordre, et déroute de toute la troupe\", from the 5th act of \"Les Fastes de la grande et ancienne Mxnxstrxndxsx\".\nNel video c'è il reportage in time-lapse delle operazioni dallo smontaggio fino alla sistemazione dello strumento nel mio furgone.\nLa location è lo stupendo Palazzo Chigi di Ariccia dove sono stato ospite de \"I Concerti dell'Accademia degli Sfaccendati\" sotto la direzione artistica di Giovanna Manci e Giacomo Fasola..\nI ragazzi che mi hanno aiutato sono: Francesco Pennisi, Simone Pazzaglia, Edoardo D'Alò e Luca Lo Verme.\nThe videoclip is a report in time-lapse of dismantling operations until the arrangement of the instrument in my van. \nThe location is the beautiful Palazzo Chigi in Ariccia, near Rome, where I was a guest of \"I Concerti dell'Accademia of the Academy of Idlers\" (Artistic directors: Giovanna Manci and Giacomo Fasola). \nThe guys who have helped me are: \nFrancesco Pennisi, Simone Pazzaglia, Edoardo D'Alo and Luca Lo Verme.\nThe soundtrack of the present video (Couperin's \"Alarm Clock\") comes from the Camerata Tokyo CD \"Claviorgan Wonderland\"\nBy clicking here\nhttp://www01.hqm-store.com/store/item...\nyou can listen some sample from “Claviorgan Wonderland”*, awarded by the Japanese Audiophile Prize (Camerata Tokyo CMCD-18244):\nFor further information about my instrument or my recordings, please don't hesitate to send me a message. \n*( from the Press: “An epoch-making album showing to the limit the potential of the Claviorgan, a combined music instrument developed by the prodigy organist, Claudio Brizi. Going through '1 day' from \"alarm clock (Le Réveil-Matin)\" by Couperin to \"Goodnight\" by John Bull, Brizi goes beyond time and space, showing flashbacks of the 250 year-long history of the keyboard instruments, and expresses incredibly multihued tones. It is well beyond belief that so many different kinds of sounds were played on one single instrument, all captured by the high quality sound recording with the wide dynamic range recording. Music fans as well as audio fans would be thoroughly enchanted.”)","commandRuns":[{"startIndex":60,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMoCEM2rARgBIhMI0vS82J6elwMVIBpoCB1FfzC9ygEEHclusg==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=_XYcBhE3gQw\u0026list=UULApK-IjidkdGK75c3lTe-w\u0026index=21\u0026t=6s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"_XYcBhE3gQw","playlistId":"UULApK-IjidkdGK75c3lTe-w","index":20,"continuePlayback":true,"startTimeSeconds":6,"loggingContext":{"vssLoggingContext":{"serializedContextData":"GhhVVUxBcEstSWppZGtkR0s3NWMzbFRlLXc%3D"}},"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr1---sn-p5qlsndz.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026msp=1\u0026odepv=1\u0026id=fd761c061137810c\u0026ip=20.55.14.57\u0026osts=6\u0026