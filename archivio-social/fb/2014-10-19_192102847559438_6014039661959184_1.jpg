"12"}}}},{"engagementPanelSectionListRenderer":{"content":{"sectionListRenderer":{"trackingParams":"CBoQui8iEwjS9LzYnp6XAxUgGmgIHUV_ML0=","hack":true}},"targetId":"PAsearch_preview","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN","onShowCommands":[{"clickTrackingParams":"CBkQ040EGAQiEwjS9LzYnp6XAxUgGmgIHUV_ML3KAQQdyW6y","scrollToEngagementPanelCommand":{"targetId":"PAsearch_preview"}}],"identifier":{"tag":"PAsearch_preview"},"loggingDirectives":{"trackingParams":"CBkQ040EGAQiEwjS9LzYnp6XAxUgGmgIHUV_ML0=","visibility":{"types":"12"}}}},{"engagementPanelSectionListRenderer":{"panelIdentifier":"engagement-panel-structured-description","content":{"structuredDescriptionContentRenderer":{"items":[{"videoTitleHeaderViewModel":{"videoTitle":{"content":"Il mio claviorgano torna a casa! My Claviorgan comes home!"},"headerButton":{"buttonViewModel":{"iconName":"CLOSE","onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQiPkBIhMI0vS82J6elwMVIBpoCB1FfzC9ygEEHclusg==","hideEngagementPanelEndpoint":{"panelIdentifier":"engagement-panel-structured-description"}}},"accessibilityText":"Close","style":"BUTTON_VIEW_MODEL_STYLE_MONO","trackingParams":"CBgQiPkBIhMI0vS82J6elwMVIBpoCB1FfzC9","type":"BUTTON_VIEW_MODEL_TYPE_TEXT","buttonSize":"BUTTON_VIEW_MODEL_SIZE_DEFAULT","loggingDirectives":{"trackingParams":"CBgQiPkBIhMI0vS82J6elwMVIBpoCB1FfzC9","visibility":{"types":"12"}}}},"rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CBcQ0f0TGAAiEwjS9LzYnp6XAxUgGmgIHUV_ML0=","visibility":{"types":"12"}}}}}},{"videoDescriptionHeaderRenderer":{"channel":{"simpleText":"claviorgan and more by Claudio Brizi"},"views":{"simpleText":"3,140 views"},"publishDate":{"simpleText":"Oct 18, 2014"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"59"},"label":{"simpleText":"Likes"},"accessibilityText":"59 likes","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtfWFljQmhFM2dRdyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"3.1K"},"label":{"simpleText":"Views"},"accessibilityText":"3,140 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2014"},"label":{"simpleText":"Oct 18"},"accessibilityText":"Oct 18, 2014","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","position":"FACTOID_POSITION_LAST"}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBIQ040EGAUiEwjS9LzYnp6XAxUgGmgIHUV_ML3KAQQdyW6y","commandMetadata":{"webCommandMetadata":{"url":"/@claviorgan","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCLApK-IjidkdGK75c3lTe-w","canonicalBaseUrl":"/@claviorgan"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_n-jIAziiCJGYi_5CMLAPCJJEmtsKcI80s6mwkn07O_ow=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Soundtrack: Claudio Brizi plays François Couperin - From/da 00:06 \"Le Réveil-Matin\" (\"The Alarm Clock\"); From/da 03:45 excerpt of \"Désordre, et déroute de toute la troupe\", from the 5th act of \"Les Fastes de la grande et ancienne Mxnxstrxndxsx\".\nNel video c'è il reportage in time-lapse delle operazioni dallo smontaggio fino alla sistemazione dello strumento nel mio furgone.\nLa location è lo stupendo Palazzo Chigi di Ariccia dove sono stato ospite de \"I Concerti dell'Accademia degli Sfaccendati\" sotto la direzione artistica di Giovanna Manci e Giacomo Fasola..\nI ragazzi che mi hanno aiutato sono: Francesco Pennisi, Simone Pazzaglia, Edoardo D'Alò e Luca Lo Verme.\nThe videoclip is a report in time-lapse of dismantling operations until the arrangement of the instrument in my van. \nThe location is the beautiful Palazzo Chigi in Ariccia, near Rome, where I was a guest of \"I Concerti dell'Accademia of the Academy of Idlers\" (Artistic directors: Giovanna Manci and Giacomo Fasola). \nThe guys who have helped me are: \nFrancesco Pennisi, Simone Pazzaglia, Edoardo D'Alo and Luca Lo Verme.\nThe soundtrack of the present video (Couperin's \"Alarm Clock\") comes from the Camerata Tokyo CD \"Claviorgan Wonderland\"\nBy clicking here\nhttp://www01.hqm-store.com/store/item...\nyou can listen some sample from “Claviorgan Wonderland”*, awarded by the Japanese Audiophile Prize (Camerata Tokyo CMCD-18244):\nFor further information about my instrument or my recordings, please don't hesitate to send me a message. \n*( from the Press: “An epoch-making album showing to the limit the potential of the Claviorgan, a combined music instrument developed by the prodigy organist, Claudio Brizi. Going through '1 day' from \"alarm clock (Le Réveil-Matin)\" by Couperin to \"Goodnight\" by John Bull, Brizi goes beyond time and space, showing flashbacks of the 250 year-long history of the keyboard instruments, and expresses incredibly multihued tones. It is well beyond belief that so many different kinds of sounds were played on one single instrument, all captured by the high quality sound recording with the wide dynamic range recording. Music fans as well as audio fans would be thoroughly enchanted.”)","commandRuns":[{"startIndex":60,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAUiEwjS9LzYnp6XAxUgGmgIHUV_ML3KAQQdyW6y","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=_XYcBhE3gQw\u0026list=UULApK-IjidkdGK75c3lTe-w\u0026index=21\u0026t=6s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"_XYcBhE3gQw","playlistId":"UULApK-IjidkdGK75c3lTe-w","index":20,"continuePlayback":true,"startTimeSeconds":6,"loggingContext":{"vssLoggingContext":{"serializedContextData":"GhhVVUxBcEstSWppZGtkR0s3NWMzbFRlLXc%3D"}},"watchEndpointSupportedOnesieConfig":{"html5Playb